{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"module": "NodeNext",
		"target": "ES2020",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"noImplicitThis": true,
		"declaration": true,
		"types": ["node"]
	},
	"typedocOptions": {
		"entryPoints": ["src/index.ts"],
		"out": "docs"
	},
	"include": ["./src/**/*.ts"],
	"exclude": ["node_modules"]
}
